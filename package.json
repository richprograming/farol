{
  "name": "farol",
  "version": "0.1.0",
  "private": true,
  "description": "Radar da reforma tributária para escritórios contábeis — Hack Brasil 2026",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "convex": "npm run dev:convex -w @farol/web",
    "dev": "npm run dev -w @farol/web",
    "build": "npm run build -w @farol/web",
    "fixtures": "npm run fixtures -w @farol/core",
    "test": "npm test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.8.0"
  }
}
